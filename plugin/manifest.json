{
  "schemaVersion": 1,
  "id": "kidush.remote-control",
  "name": "Remote Control",
  "version": "0.1.0",
  "author": "kidush",
  "license": "MIT",
  "description": "Control IR devices, like an air conditioner on a Tuya IR blaster, from the bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Remote Control",
    "description": "Air conditioner state in the bar, with power, mode, temperature, fan and presets in a popup",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "binary": "",
      "fake": false
    },
    "schema": [
      {
        "key": "binary",
        "type": "string",
        "label": "rc binary (empty for ~/.local/bin/rc)",
        "defaultValue": ""
      },
      {
        "key": "fake",
        "type": "boolean",
        "label": "Use the fake blaster (testing)",
        "defaultValue": false
      }
    ]
  }
}
